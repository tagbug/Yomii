---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<dialog id="privacy" aria-labelledby="privacy-title">
  <div class="dialog-head">
    <h2 id="privacy-title">关于本站</h2>
    <button
      type="button"
      data-close="privacy"
      aria-label="关闭"
      class="icon-button"
    >×</button>
  </div>
  <p>本站收录《{title}》。</p>
  <p>阅读进度、书签和偏好设置均保存在本地浏览器中。</p>
</dialog>
